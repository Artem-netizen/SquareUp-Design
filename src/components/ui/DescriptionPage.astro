---
import Heading from "@components/ui/Heading.astro";

interface DescriptionPageProps {
  title: string;
  text?: string;
  badge?: string;
}

const {
  title = 'At SquareUp',
  text,
  badge,
  ...rest
} = Astro.props;
---

<div
   class="desc"
   {...rest}
>
  <div class="desc__inner">
    <Heading
       tag="h3"
       styled={{
         size: 'subtitle',
         lineHeight: 'normal',
         letterSpacing: 'normal',
       }}
    >
      {title}
    </Heading>
    <Heading
       tag="p"
       styled={{
         size: 'text--md',
         fontWeight: 400,
       }}
    >
      {text}
    </Heading>
  </div>
  <Heading
     tag="span"
     styled={{
       size: 'text--4xl',
       fontWeight: 400,
       lineHeight: 'normal',
       letterSpacing: 'normal',
       textTransform: 'normal',
     }}
     class="desc__badge"
  >
    {badge}
  </Heading>
</div>

<style lang="scss" is:global>
  @import "@styles/helpers/functions.scss";
  @import "@styles/helpers/mixins.scss";
  @import "@styles/helpers/media.scss";

  .desc {
    @include flex-custom(
      $direction: column,
      $alignItems: start,
      $gap: rem(30),
    );
    padding: rem(38) rem(14) rem(38);
    border-top: var(--border);
    @include tablet {
      padding: rem(78) rem(38) rem(38);
      gap: rem(40);
    }
    @include laptop {
      padding: rem(118) rem(48) rem(48);
      gap: rem(50);
    }
    
    &:first-of-type {
      border-top: none;
    }

    &__inner {
      @include flex-custom(
        $direction: column,
        $gap: rem(6),
      );
      @include tablet {
        gap: rem(10);
      }
      @include laptop {
        gap: rem(14);
      }
    }

    &__badge {
      padding: rem(10);
      display: inline-block;
      overflow: hidden;
      border-radius: rem(6);
      background-color: var(--color-dark-15);
      @include laptop {
        padding: rem(12) rem(14);
        border-radius: rem(8);
      }
    }
  }
</style>