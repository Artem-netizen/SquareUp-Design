---
import BaseIcon from "@components/shared/StaticIcon.astro";
import Heading from "@components/ui/Heading.astro";

const {
  tag = 'div',
  question,
  answer
} = Astro.props;

const Tag = tag;
---

<Tag class="accordion__item">
  <BaseIcon
     tag="span"
     variant="default"
     classChild="counter-num"
  />
  
  <div class="accordion__content">
    <button
       class="accordion__btn w-full"
       type="button"
       aria-label="Open/Close accordion"
       aria-expanded="false"
    >
      <Heading
        className="accordion__btn-title"
        tag="h6"
        styled={{
          size: 'text--4xl',
          fontWeight: 500,
        }}
      >
        {question}
      </Heading>
      
      <svg class="accordion__btn-icon" width="34" height="34" viewBox="0 0 34 34" fill="none">
        <path d="M18.275 8.0748C18.275 7.37064 17.7042 6.7998 17 6.7998C16.2959 6.7998 15.725 7.37064 15.725 8.0748V15.7248H8.07505C7.37089 15.7248 6.80005 16.2956 6.80005 16.9998C6.80005 17.704 7.37089 18.2748 8.07505 18.2748L15.725 18.2748V25.9248C15.725 26.629 16.2959 27.1998 17 27.1998C17.7042 27.1998 18.275 26.629 18.275 25.9248V18.2748L25.925 18.2748C26.6292 18.2748 27.2 17.704 27.2 16.9998C27.2 16.2956 26.6292 15.7248 25.925 15.7248H18.275V8.0748Z" fill="white"/>
      </svg>
    </button>
    
    <div class="accordion__item-answer">
      <p class="accordion__answer">{answer}</p>
    </div>
  </div>
</Tag>

<style lang="scss" is:global>
  @import "@styles/helpers/functions.scss";
  @import "@styles/helpers/mixins.scss";
  @import "@styles/helpers/media.scss";
  
  .accordion {
    &__wrapper {
      position: relative;
      border-bottom: var(--border);
      @include tablet {
        padding-block: rem(60);
      }
      @include laptop {
        padding-block: rem(80);
      }
      
      &::after,
      &::before {
        @include tablet {
          height: rem(60);
        }
        @include laptop {
          height: rem(80);
        }
        content: '';
        @include abs-x;
        width: rem(1);
        background-color: var(--color-dark-15);
      }
      
      &::after {
        top: 0;
      }
      
      &::before {
        bottom: 0;
      }
    }
    
    &-left {
      border-right: var(--border);
    }
    
    &__item {
      @include flex-custom(
        $jc: space-between,
        $alignItems: center,
        $gap: rem(20),
      );
      padding: rem(30) rem(24);
      border-bottom: var(--border);
      @include tablet {
        padding-inline: rem(40);
      }
      @include laptop {
        padding: rem(34) rem(50);
      }
      &:nth-of-type(-n + 1) {
        border-top: var(--border);
      }
      
      &-answer {
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        will-change: max-height;
        transition: all var(--transition-duration) var(--ease-quint);
      }
      
      &.is-open {
        align-items: flex-start;
        .accordion__item-answer {
          opacity: 1;
        }
        
        .accordion__counter {
          color: var(--color-green-50);
        }
        
        .accordion__btn-title,
        &::before {
          color: var(--color-green-70);
        }

        .accordion__btn {
          &-icon {
            transform: rotate(-135deg);
            path {
              fill: var(--color-green-70);
            }
          }
        }
      }
    }
    
    &__btn {
      @include flex-custom(
        $jc: space-between,
        $alignItems: center,
        $gap: rem(40),
      );
      padding-block: rem(7);
      position: relative;
      height: fit-content;
      text-align: left;
      @include tablet {
        padding-block: rem(24);
      }
      &-title {
        flex-grow: 1;
      }
      
      &-icon {
        @include square(26);
        @include tablet {
          @include square(34);
        }
        flex-shrink: 0;
        transition: transform var(--transition-duration) var(--ease-quint);
      }
    }
  }
</style>

<script>
  const initAccordion = () => {
    const accordions = document.querySelectorAll('.accordion__item');
    
    accordions.forEach((el, event) => {
      el.addEventListener('click', event => {
        const self = event.currentTarget as HTMLElement;
        const controlBtn = self.querySelector('.accordion__btn') as HTMLElement;
        const revealContent = self.querySelector('.accordion__item-answer') as HTMLElement;
        
        self.classList.toggle('is-open');
        
        if(self.classList.contains('is-open')) {
          controlBtn.setAttribute('aria-expanded', 'true');
          revealContent.style.maxHeight = revealContent.scrollHeight + 'px';
        } else {
          controlBtn.setAttribute('aria-expanded', 'false');
          revealContent.style.maxHeight = null;
        }
      });
    });
  }
  
  document.addEventListener("DOMContentLoaded", initAccordion);
</script>