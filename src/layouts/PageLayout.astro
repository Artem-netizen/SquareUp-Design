---
import '../assets/styles/main.scss';
import Head from '@layouts/Head.astro';
import Header from '@components/common/Header.astro';
import Footer from "@components/common/Footer.astro";
import MobileMenu from "@components/common/MobileMenu.astro";

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<Head title={title} description={description} />
	<body>
		<div class="wrapper">
			<div class="content">
				<Header />
				<MobileMenu />
				<main class="main">
					<slot />
				</main>
			</div>
			<Footer />
		</div>
	</body>
</html>

<style lang="scss">
	@import "@styles/helpers/functions.scss";
	@import "@styles/helpers/mixins.scss";
	@import "@styles/helpers/media.scss";
	
	.main {
		margin-top: var(--offset-top, rem(100));
		height: 100%;
	}
</style>

<script is:inline>
	document.addEventListener("DOMContentLoaded", () => {
		const main = document.querySelector("main");
		const headerHeight = document.querySelector("header")?.offsetHeight;
	
		if (!main || !headerHeight) return;
		
		document.documentElement.style.setProperty('--offset-top', `${headerHeight}px`);
	});
</script>